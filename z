#
# Utility for building QuickJS for Nanvix.
#
# Run './z help' for more information on how to use this utility.
#

#==================================================================================================

# Fast fail on errors, unset variables, and pipe failures.
set -euo pipefail

#===================================================================================================
# Global Constants
#===================================================================================================

# Project name
PROJECT_NAME="quickjs"

# Scripts directory.
SCRIPTS_DIR="etc/scripts"

# Name of the build command.
CMD_NAME_BUILD="build"
# Name of the clean command.
CMD_NAME_CLEAN="clean"
# Name of the configure command.
CMD_NAME_CONFIGURE="configure"
# Name of the help command.
CMD_NAME_HELP="help"
# Name of the install command.
CMD_NAME_INSTALL="install"

# Name of the sysroot directory option.
OPT_NAME_SYSROOT_PATH="--sysroot-path"
# Name of the toolchain directory option.
OPT_NAME_TOOLCHAIN_PATH="--toolchain-path"
# Name of the with-docker option.
OPT_NAME_WITH_DOCKER="--with-docker"

# Default path to the sysroot directory.
DEFAULT_SYSROOT_PATH="${HOME}/sysroot"
# Default path to the toolchain directory.
DEFAULT_TOOLCHAIN_PATH="${HOME}/toolchain"

# Docker image name for the Nanvix toolchain.
DOCKER_IMAGE_NAME="nanvix/toolchain:v0.11.x-minimal-test"
# Path to the toolchain inside the Docker image.
DOCKER_TOOLCHAIN_PATH="/opt/nanvix"

# Name of cache file.
Z_CACHE_FILE=".z.cache"

#===================================================================================================
# Global Variables
#===================================================================================================

# Path to Nanvix sysroot directory.
SYSROOT_DIR=${DEFAULT_SYSROOT_PATH}
# Path to the Nanvix toolchain directory.
TOOLCHAIN_DIR=${DEFAULT_TOOLCHAIN_PATH}
# Build with Docker flag.
BUILD_WITH_DOCKER=false

#===================================================================================================
# Functions
#===================================================================================================

#
# Description
#   Checks if Docker is installed and aborts if it is not.
#
# Usage Example
#   check_docker_installed
#
check_docker_installed() {
    if ! command -v docker >/dev/null 2>&1; then
        panic "Docker is not installed. Please install Docker to build with Docker."
    fi
}

#
# Description
#   Checks if the Docker image is available locally and aborts if it is not.
#
# Usage Example
#   check_docker_image_available
#
check_docker_image_available() {
    if ! docker image inspect "${DOCKER_IMAGE_NAME}" >/dev/null 2>&1; then
        panic "Docker image '${DOCKER_IMAGE_NAME}' not found. Run 'docker pull ${DOCKER_IMAGE_NAME}' first."
    fi
}

configure() {
    # No configuration needed.
    return 0
}

#
# Description
#
#   Builds artifacts.
#
# Return Value
#
#   - 0 if the build was successful.
#   - Non-zero if an error occurred.
#
# Usage Example
#
#   build || echo "Build failed"
#
build() {
    print_info "Building ${PROJECT_NAME} ..."

    if ${BUILD_WITH_DOCKER}; then
        build_with_docker
    else
        build_local
    fi
}

#
# Description
#
#   Builds artifacts using the local toolchain.
#
# Return Value
#
#   - 0 if the build was successful.
#   - Non-zero if an error occurred.
#
build_local() {
    # Add ${TOOLCHAIN_DIR}/bin to PATH.
    export PATH="${TOOLCHAIN_DIR}/bin:${PATH}"

    # Pass NANVIX_HOME and NANVIX_TOOLCHAIN to make so it uses the correct paths.
    make -j \
        CROSS_PREFIX=i686-nanvix- \
        CONFIG_NANVIX=yes \
        NANVIX_TOOLCHAIN="${TOOLCHAIN_DIR}" \
        NANVIX_HOME="${SYSROOT_DIR}" \
        all
    local build_status=$?

    # Restore PATH.
    export PATH="${PATH#${TOOLCHAIN_DIR}/bin:}"

    return ${build_status}
}

#
# Description
#
#   Builds artifacts using Docker.
#
# Return Value
#
#   - 0 if the build was successful.
#   - Non-zero if an error occurred.
#
build_with_docker() {
    check_docker_installed
    check_docker_image_available

    local workspace_path
    workspace_path="$(pwd -P)"

    # Define paths inside Docker container
    local docker_sysroot="/mnt/sysroot"
    local docker_workspace="/mnt/workspace"

    # Get current user's UID and GID for proper file ownership
    local uid
    local gid
    uid=$(id -u)
    gid=$(id -g)

    print_info "Building with Docker image: ${DOCKER_IMAGE_NAME}"

    # Pass NANVIX_HOME to make so it uses the correct paths for linker scripts and libraries.
    # The Makefile uses NANVIX_HOME to derive NANVIX_LDFLAGS and NANVIX_LIBS.
    # Run as current user to avoid permission issues with generated files.
    docker run --rm \
        --user "${uid}:${gid}" \
        -v "${workspace_path}:${docker_workspace}" \
        -v "${SYSROOT_DIR}:${docker_sysroot}:ro" \
        -w "${docker_workspace}" \
        "${DOCKER_IMAGE_NAME}" \
        /bin/bash -c "
            set -e
            export PATH=\"${DOCKER_TOOLCHAIN_PATH}/bin:\${PATH}\"
            export HOME=/tmp

            make -j \
                CROSS_PREFIX=i686-nanvix- \
                CONFIG_NANVIX=yes \
                NANVIX_TOOLCHAIN=${DOCKER_TOOLCHAIN_PATH} \
                NANVIX_HOME=${docker_sysroot} \
                all
        "
}

#
# Description
#
#   Installs build artifacts.
#
# Return Value
#
#   - 0 if the install was successful.
#   - Non-zero if an error occurred.
#
# Usage Example
#
#   install || echo "Installation failed"
#
install() {
    print_info "Installing ${PROJECT_NAME} ..."

    PREFIX="${SYSROOT_DIR}" \
    make install || return $?

    return 0
}

#
# Description
#
#   Cleans build artifacts.
#
# Return Value
#
#   - 0 if the clean was successful.
#   - Non-zero if an error occurred.
#
# Usage Example
#
#   clean || echo "Clean failed"
#
clean() {
    print_info "Cleaning ${PROJECT_NAME} ..."

    make clean || return $?

    git clean -fdx || return $?

    return 0
}

#
# Description
#
#   Prints a help message.
#
# Usage Example
#
#   print_help
#
print_help() {
    cat <<EOF

Utility script for building ${PROJECT_NAME} for Nanvix.

Usage
  $0 COMMAND [OPTIONS]
  $0 ${CMD_NAME_BUILD} [${OPT_NAME_WITH_DOCKER}]
  $0 ${CMD_NAME_CLEAN}
  $0 ${CMD_NAME_CONFIGURE} [${OPT_NAME_SYSROOT_PATH}=PATH] [${OPT_NAME_TOOLCHAIN_PATH}=PATH] [${OPT_NAME_WITH_DOCKER}]
  $0 ${CMD_NAME_INSTALL}
  $0 ${CMD_NAME_HELP}

Commands
  ${CMD_NAME_BUILD}      Build artifacts.
  ${CMD_NAME_CLEAN}      Remove build artifacts.
  ${CMD_NAME_CONFIGURE}  Configure the build.
  ${CMD_NAME_INSTALL}    Install built artifacts.
  ${CMD_NAME_HELP}       Display this help message.

Options
  ${OPT_NAME_SYSROOT_PATH}    Path to Nanvix sysroot directory (default: ${DEFAULT_SYSROOT_PATH}).
  ${OPT_NAME_TOOLCHAIN_PATH}  Path to the Nanvix toolchain directory (default: ${DEFAULT_TOOLCHAIN_PATH}).
  ${OPT_NAME_WITH_DOCKER}     Build using Docker image '${DOCKER_IMAGE_NAME}'.
EOF
}

#
# Description
#   Writes command line arguments to a cache file.
#   Each argument is written on a separate line.
#
# Arguments
#   $@ - The full command line arguments.
#
# Usage Example
#   write_cache "${args[@]}"
#
write_cache() {
    printf '%s\n' "${@}" > "${Z_CACHE_FILE}"
}

#
# Description
#   Reads the command line arguments from the cache file.
#   Sets the following global variables:
#     - TOOLCHAIN_DIR
#     - SYSROOT_DIR
#     - BUILD_WITH_DOCKER
#
# Return Value
#   - 0 if the cache file was successfully read.
#   - 1 if an error occurred while reading the cache file.
#
# Usage Example
#   read_cache && echo "Cache read successfully" || echo "Failed to read cache"
#
read_cache() {
    # Check if the cache file exists.
    if [[ ! -f "${Z_CACHE_FILE}" ]]; then
        return 1
    fi

    if [[ -f "${Z_CACHE_FILE}" ]]; then
        local cache_lines
        mapfile -t cache_lines < "${Z_CACHE_FILE}"
        # Check if the cache file is empty.
        if [[ ${#cache_lines[@]} -eq 0 ]]; then
            return 1
        fi
        # Process the cache lines to determine the last build options.
        for arg in "${cache_lines[@]}"; do
            case $arg in
                ${OPT_NAME_SYSROOT_PATH}=*)
                    SYSROOT_DIR="${arg#*=}"
                    ;;
                ${OPT_NAME_TOOLCHAIN_PATH}=*)
                    TOOLCHAIN_DIR="${arg#*=}"
                    ;;
                ${OPT_NAME_WITH_DOCKER})
                    BUILD_WITH_DOCKER=true
                    ;;
                *)
                    print_error "Skipping unknown cached argument: ${arg}"
                    ;;
            esac
        done
    fi

    return 0
}

#
# Description
#
#   Prints an error message and abort execution.
#
# Arguments
#
#   $1 - The panic message to print.
#
# Usage Example
#
#   panic "Something went terribly wrong"
#
panic() {
    echo -e "\033[31m[PANIC] ${1}\033[0m" >&2
    exit 1
}

#===================================================================================================
# Main Script
#===================================================================================================

main() {
    # Check if no arguments were provided.
    if [ $# -eq 0 ]; then
        panic "No command specified, run '${0} ${CMD_NAME_HELP}' for help"
    fi

    # Extract command from arguments.
    local cmd
    cmd="$1"
    shift

    # Handle help command.
    case ${cmd} in
        "${CMD_NAME_HELP}")
            print_help
            return 0
            ;;
        "${CMD_NAME_BUILD}" | \
        "${CMD_NAME_CLEAN}" | \
        "${CMD_NAME_CONFIGURE}" | \
        "${CMD_NAME_INSTALL}")
            # Valid commands will be handled below.
            ;;
        *)
            print_error "Unknown command: ${cmd}"
            return 1
            ;;
    esac

    # Parse command line arguments.
    local args=()
    while [[ $# -gt 0 ]]; do
        arg="$1"
        args+=("${arg}")
        case $arg in
            ${OPT_NAME_SYSROOT_PATH}=*)
                SYSROOT_DIR="${arg#*=}"
                ;;
            ${OPT_NAME_TOOLCHAIN_PATH}=*)
                TOOLCHAIN_DIR="${arg#*=}"
                ;;
            ${OPT_NAME_WITH_DOCKER})
                BUILD_WITH_DOCKER=true
                ;;
            *)
                panic "Unknown argument: ${arg}, run '${0} ${CMD_NAME_HELP}' for help"
                ;;
        esac
        shift
    done

    # Save/restore cache as needed.
    if [[ "${cmd}" == "${CMD_NAME_CONFIGURE}" ]]; then
        if [[ ${#args[@]} -gt 0 ]]; then
            write_cache "${args[@]}"
        else
            # Write empty cache if no arguments.
            echo "" > "${Z_CACHE_FILE}"
        fi
    else
        read_cache || {
            panic "Failed to restore cache. Run './z configure' first."
        }
    fi

    # Source files in ${SYSROOT_DIR}/etc/scripts/ (only for non-Docker builds).
    if ! ${BUILD_WITH_DOCKER}; then
        if [ -d "${SYSROOT_DIR}/${SCRIPTS_DIR}/" ]; then
            for script in "${SYSROOT_DIR}/${SCRIPTS_DIR}/"*.sh; do
                if [ -f "$script" ]; then
                    # shellcheck source=/dev/null
                    source "$script"
                fi
            done
        else
            panic "Cannot source scripts in '${SYSROOT_DIR}/${SCRIPTS_DIR}/'. Run './z configure' first."
        fi
    else
        # Define minimal logging functions for Docker builds.
        print_info() { echo -e "\033[34m[INFO] ${1}\033[0m"; }
        print_success() { echo -e "\033[32m[SUCCESS] ${1}\033[0m"; }
        print_error() { echo -e "\033[31m[ERROR] ${1}\033[0m" >&2; }
        print_warning() { echo -e "\033[33m[WARNING] ${1}\033[0m"; }
    fi

    case ${cmd} in
        "${CMD_NAME_BUILD}")
            build || {
                print_error "Build failed."
                exit 1
            }

            print_success "Build complete."
            ;;
        "${CMD_NAME_CLEAN}")
            clean || {
                print_error "Clean failed."
                exit 1
            }
            print_success "Clean complete."
            ;;
        "${CMD_NAME_CONFIGURE}")

            configure || {
                print_error "Configuration failed."
                exit 1
            }
            print_success "Configuration complete."
            ;;
        "${CMD_NAME_INSTALL}")
            install || {
                print_error "Installation failed."
                exit 1
            }
            print_success "Installlation complete."
            ;;
        "${CMD_NAME_HELP}")
            print_help
            ;;
        *)
            print_error "Unknown command: ${cmd}"
            print_help
            exit 1
            ;;
    esac
}

main "${@}"
