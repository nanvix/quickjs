# Makefile.nanvix - QuickJS cross-compilation for Nanvix
#
# Copyright(c) The Maintainers of Nanvix.
# Licensed under the MIT License.
#
# Usage (invoked via .nanvix/z.py):
#   make -f Makefile.nanvix PLATFORM=<p> PROCESS_MODE=<m> MEMORY_SIZE=<s> \
#     NANVIX_HOME=<sysroot> NANVIX_TOOLCHAIN=<toolchain> [target]
#
# This Makefile is a thin wrapper around the upstream QuickJS Makefile (which
# is itself Nanvix-aware). Cross-compilation always runs inside the
# toolchain Docker container; this wrapper is only invoked from there for
# build goals, and natively for everything else.

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is expected to be invoked via z.py.
# 2. Build goals (all, install) require the cross-toolchain at
#    $(NANVIX_TOOLCHAIN) and the LIB_OUT/INCLUDE_OUT/BIN_OUT paths; other
#    goals (test-*, clean) are pure host-side.
# 3. Test and release targets assume build artifacts already exist; they
#    fail fast with a hint if they don't. The expected workflow is
#    `./z build` before `./z test` or `./z release`.

.DEFAULT_GOAL=all
EXE = .elf

PLATFORM ?= hyperlight
PROCESS_MODE ?= multi-process
MEMORY_SIZE ?= 128mb

_NANVIX_DOCKER_BUILD_GOALS := all install
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined.
_REQUIRED := PLATFORM \
    PROCESS_MODE \
    MEMORY_SIZE \
    NANVIX_HOME \
    NANVIX_TOOLCHAIN \
    NANVIX_ROOT \
    OUT_DIR \
    DIST_DIR \
    LIB_OUT \
    INCLUDE_OUT \
    BIN_OUT
ifneq ($(filter-out clean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

SYSROOT_PATH := $(abspath $(NANVIX_HOME))

# Artifacts staged by `install` into the release/test output tree so that
# `./z release` (which packages release_dir()) can find them.  Headers
# and the static library land under a `quickjs/` subdir to preserve the
# `#include <quickjs/quickjs.h>` namespacing used by downstream consumers.
BIN_ARTIFACTS     := qjs$(EXE) qjsc$(EXE)
LIB_ARTIFACTS     := libquickjs.a
INCLUDE_ARTIFACTS := quickjs.h quickjs-libc.h

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc),)
    $(error Nanvix toolchain not found at $(NANVIX_TOOLCHAIN))
  endif
endif

# Arguments forwarded to the upstream Makefile.
UPSTREAM_MAKE_ARGS := CONFIG_NANVIX=y \
  NANVIX_HOME="$(NANVIX_HOME)" \
  NANVIX_TOOLCHAIN="$(NANVIX_TOOLCHAIN)"

# ===========================================================================
# Build Targets
# ===========================================================================

all: install

# Build all upstream artifacts in a single recursive invocation.  Phony
# (the upstream Makefile owns the real timestamps); install depends on
# this so a standalone `make -f Makefile.nanvix install` also builds.
_upstream-build:
	$(MAKE) $(UPSTREAM_MAKE_ARGS) all

# Stage built artifacts into the release/test output tree so that
# `./z release` (which packages release_dir()) can find them.
install: _upstream-build
	@mkdir -p $(LIB_OUT)/quickjs $(INCLUDE_OUT)/quickjs $(BIN_OUT)
	cp -f $(BIN_ARTIFACTS)     $(BIN_OUT)/
	cp -f $(LIB_ARTIFACTS)     $(LIB_OUT)/quickjs/
	cp -f $(INCLUDE_ARTIFACTS) $(INCLUDE_OUT)/quickjs/
	-cp -f libquickjs.lto.a    $(LIB_OUT)/quickjs/ 2>/dev/null || true

# ===========================================================================
# Test Targets
# ===========================================================================

_FUNCTIONAL_TEST_FILES := \
  tests/test_closure.js \
  tests/test_language.js \
  tests/test_builtin.js \
  tests/test_loop.js \
  tests/test_bigint.js \
  tests/test_cyclic_import.js \
  tests/test_worker.js \
  tests/test_std_nanvix.js

test-functional: $(_FUNCTIONAL_TEST_FILES)
	@echo "=== QuickJS functional tests ==="
ifeq ($(PROCESS_MODE),standalone)
	@echo "  FAIL: Standalone functional tests are not handled by this Makefile."
	@echo "         Run './z test test-functional' instead (handled in z.py)."
	@exit 1
endif
	@echo "  Running tests via nanvixd.elf..."
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) $(abspath tests/test_closure.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) $(abspath tests/test_language.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) --std $(abspath tests/test_builtin.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) $(abspath tests/test_loop.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) $(abspath tests/test_bigint.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) $(abspath tests/test_cyclic_import.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) --std $(abspath tests/test_worker.js)
	cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf -- \
	  $(abspath qjs$(EXE)) --std $(abspath tests/test_std_nanvix.js)
	@echo "  PASS: QuickJS functional tests"

test: test-functional
	@echo "=== All QuickJS tests PASSED ==="

# ===========================================================================
# Clean
# ===========================================================================

clean:
	-$(MAKE) CONFIG_NANVIX=y clean 2>/dev/null || true
	rm -f qjs.elf qjsc.elf run-test262.elf
	rm -rf $(OUT_DIR) dist/

.PHONY: all install _upstream-build clean test test-functional
